# ==============================================================================
# PAKPAYMENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and update with your own values:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL
# ------------------------------------------------------------------------------
# The public base URL where your application is running.
# In local development: http://localhost:3000
# In production: https://yourdomain.com or https://pakpayment.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection string (Local MongoDB or MongoDB Atlas cluster)
# Local example: mongodb://localhost:27017/pakpayment
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pakpayment?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pakpayment

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=your_32_character_random_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (Nodemailer SMTP)
# ------------------------------------------------------------------------------
# Used for password resets, email verification, and merchant claim notifications.
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# ------------------------------------------------------------------------------
# 5. UI TOAST & NOTIFICATION SETTINGS
# ------------------------------------------------------------------------------
# Default duration for in-app alert toasts in milliseconds (e.g., 5000 = 5 seconds)
NEXT_PUBLIC_TOAST_DURATION=5000

# ------------------------------------------------------------------------------
# 6. OPTIONAL: CLOUDINARY CDN STORAGE (For Payment Proof Screenshots)
# ------------------------------------------------------------------------------
# Optional image storage. If left empty, local base64 or file storage is used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
